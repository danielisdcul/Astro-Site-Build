---
import type { GalleryImage } from '../data/gallery.ts';
import { withBase } from '../utils/paths.ts';

type Props = { image: GalleryImage; eager?: boolean };
const { image, eager = false } = Astro.props;
const preview = withBase(image.previewSrc || image.src);
---

<!-- Let the browser choose the smaller mobile source before downloading anything. -->
<picture>
	{image.previewSrc && <source media="(max-width: 800px)" srcset={preview} />}
	<img
		src={withBase(image.src)}
		data-gallery-preview={preview}
		alt={image.alt}
		width={image.width}
		height={image.height}
		loading={eager ? 'eager' : 'lazy'}
		decoding="async"
		draggable="false"
	/>
</picture>
