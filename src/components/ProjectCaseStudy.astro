---
import type { Project } from '../data/projects/types.ts';
import { withBase } from '../utils/paths.ts';
import Gallery from './Gallery.astro';

type Props = {
	project: Project;
};

const { project } = Astro.props;
const gallery = project.gallery ?? {
	layout: project.galleryLayout,
	images: project.cardImages.map((src, index) => ({ src, alt: `${project.title} project image ${index + 1}` })),
};
---

<article class="case-study">
	<header class="case-study__hero shell">
		<p class="eyebrow">{project.type}</p>
		<h1>{project.title}</h1>
		<p class="case-study__lede">{project.summary}</p>
		<dl class="project-details">
			{
				project.details.map((detail) => (
					<div>
						<dt>{detail.label}</dt>
						<dd>{detail.value}</dd>
					</div>
				))
			}
		</dl>
		{project.links && project.links.length > 0 && (
			<section class="project-links" aria-labelledby="project-links-heading">
				<h2 class="eyebrow" id="project-links-heading">Project links</h2>
				<ul class="project-links__list list-reset">
					{project.links.map((link) => (
						<li>
							<a class="text-link" href={withBase(link.href)} target="_blank" rel="noreferrer">
								{link.label} <span class="link-arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
	</header>

	<div class="shell case-study__feature">
		<Gallery {...gallery} label={`${project.title} project gallery`} eager />
	</div>

	<div class="shell case-study__content">
		{
			project.sections.map((section) => (
				<section class="case-study__section content-split content-split--case-study">
					<div>
						<p class="eyebrow">{section.title}</p>
					</div>
					<div class="case-study__section-body">
						{section.lead && <p class="case-study__lead">{section.lead}</p>}

						{section.listBeforeParagraphs && section.list && (
							<ul>
								{section.list.map((item) => <li>{item}</li>)}
							</ul>
						)}

						{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}

						{!section.listBeforeParagraphs && section.list && (
							<ul>
								{section.list.map((item) => <li>{item}</li>)}
							</ul>
						)}

						{section.details && (
							<dl class="section-details">
								{section.details.map((detail) => (
									<div>
										<dt>{detail.label}</dt>
										<dd>{detail.value}</dd>
									</div>
								))}
							</dl>
						)}

						{section.link && (
							<p>
								<a
									class="text-link"
									href={section.link.href}
									target="_blank"
									rel="noreferrer"
								>
									{section.link.label} <span class="link-arrow" aria-hidden="true">↗</span>
								</a>
							</p>
						)}
					</div>
				</section>
			))
		}
	</div>

	<div class="shell case-study__next">
		<a href={withBase('/')}>← Back to selected work</a>
	</div>
</article>
