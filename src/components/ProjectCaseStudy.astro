---
import type { Project } from '../data/projects/types.ts';
import { getGallerySlides, type GalleryOptions, type GallerySlide } from '../data/gallery.ts';
import { createSectionNavigation, flattenSectionNavigation, type SectionNavigationItem } from '../utils/section-navigation';
import { withBase } from '../utils/paths.ts';
import Gallery from './Gallery.astro';
import ProgressiveImage from './ProgressiveImage.astro';

type Props = {
	project: Project;
	sectionNavigation?: SectionNavigationItem[];
};

const { project, sectionNavigation = createSectionNavigation(project.sections) } = Astro.props;
const sectionNavigationInDocumentOrder = flattenSectionNavigation(sectionNavigation);
const gallery: GalleryOptions = project.gallery ?? {
	layout: project.cardLayout,
	images: project.cardImages.map((src, index) => ({ src, alt: `${project.title} project image ${index + 1}` })),
};
// A case-study viewer follows every authored image and video in document order.
const pageSlides: GallerySlide[] = [
	...getGallerySlides(gallery.images, gallery.videos),
	...project.sections.flatMap((section) => [
		...(section.videos ?? []).map((video) => ({ ...video, type: 'video' as const, alt: video.caption })),
		...getGallerySlides(section.gallery?.images ?? [], section.gallery?.videos),
	]),
];
const videoSlideIndex = (src: string) => pageSlides.findIndex((slide) => 'type' in slide && slide.src === src);
---

<article class:list={['case-study', { 'case-study--margin-media': project.sections.some((section) => section.gallery) }]}>
	<header class="case-study__hero shell">
		<p class="eyebrow">{project.type}</p>
		<h1>{project.title}</h1>
		<p class="case-study__lede">{project.summary}</p>
		<dl class="project-details">
			{
				project.details.map((detail) => (
					<div>
						<dt>{detail.label}</dt>
						<dd>{detail.value}</dd>
					</div>
				))
			}
		</dl>
		{project.links && project.links.length > 0 && (
			<section class="project-links" aria-labelledby="project-links-heading">
				<h2 class="eyebrow" id="project-links-heading">Project links</h2>
				<ul class="project-links__list list-reset">
					{project.links.map((link) => (
						<li>
							<a class="text-link" href={withBase(link.href)} target="_blank" rel="noreferrer">
								{link.label} <span class="link-arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)}
	</header>

	<div class="shell case-study__feature" id="project-gallery">
		<Gallery {...gallery} viewerSlides={pageSlides} pageViewer label={`${project.title} project gallery`} eager />
	</div>

	<div class="shell case-study__content">
		{
				project.sections.map((section, index) => (
				<section class="case-study__section content-split content-split--case-study" id={sectionNavigationInDocumentOrder[index].id}>
					<div class="case-study__section-heading">
						<h2 class="eyebrow">{section.title}</h2>
					</div>
					<div class="case-study__section-body">
						{section.lead && <p class="case-study__lead">{section.lead}</p>}

						{section.listBeforeParagraphs && section.list && (
							<ul>
								{section.list.map((item) => <li>{item}</li>)}
							</ul>
						)}

						{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}

						{!section.listBeforeParagraphs && section.list && (
							<ul>
								{section.list.map((item) => <li>{item}</li>)}
							</ul>
						)}

						{section.details && (
							<dl class="section-details">
								{section.details.map((detail) => (
									<div>
										<dt>{detail.label}</dt>
										<dd>{detail.value}</dd>
									</div>
								))}
							</dl>
						)}

						{section.link && (
							<p>
								<a
									class="text-link"
									href={section.link.href}
									target="_blank"
									rel="noreferrer"
								>
									{section.link.label} <span class="link-arrow" aria-hidden="true">↗</span>
								</a>
							</p>
						)}
					</div>
					{section.videos && section.videos.length > 0 && (
						<div class:list={['case-study__videos', { 'case-study__videos--pair': section.videos.length > 1 }]}>
							{section.videos.map((video) => (
								<figure class:list={['case-study__video', { 'case-study__video--portrait': video.height > video.width }]}>
									<button
										class="case-study__video-trigger"
										type="button"
										data-gallery-video-trigger
										data-gallery-index={videoSlideIndex(video.src)}
										aria-label={`Play ${video.caption} in gallery`}
										style={`aspect-ratio: ${video.width} / ${video.height};`}
									>
										<ProgressiveImage src={video.poster} alt="" width={video.width} height={video.height} upgrade="preview" />
										<span class="gallery__play" aria-hidden="true">▶</span>
									</button>
									<figcaption class="gallery__caption">
										<span class="gallery__caption-text">{video.caption}</span>
									</figcaption>
								</figure>
							))}
						</div>
					)}
					{section.gallery && (
						<div class="case-study__section-media">
							<Gallery {...section.gallery} viewerSlides={pageSlides} pageViewer={false} label={`${project.title} — ${section.title}`} />
						</div>
					)}
				</section>
			))
		}
	</div>

	<div class="shell case-study__next">
		<a href={withBase('/')}>← Back to selected work</a>
	</div>
</article>
