---
import type { GalleryOptions } from '../data/gallery.ts';
import { withBase } from '../utils/paths.ts';
import GalleryPreview from './GalleryPreview.astro';

type Props = GalleryOptions & {
	label?: string;
	/** Load the first image eagerly when the gallery is near the top of a page. */
	eager?: boolean;
};

const {
	images,
	layout = 'grid',
	columns = 2,
	lightbox = true,
	label = 'Image gallery',
	eager = false,
} = Astro.props;
---

{images.length > 0 && (
	<image-gallery class="gallery" role="group" aria-label={label}>
		<div class:list={['gallery__grid', `gallery__grid--${layout}`]} style={`--gallery-columns: ${columns};`}>
			{images.map((image, index) => (
				<figure class="gallery__item">
					<div class="gallery__media">
						{lightbox ? (
							<a class="gallery__trigger" href={withBase(image.src)} aria-label={`View larger image: ${image.alt}`}>
								<GalleryPreview image={image} eager={eager && index === 0} />
								<span class="gallery__expand" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 4h6v6M20 4l-7 7M10 20H4v-6M4 20l7-7" /></svg>
								</span>
							</a>
						) : (
							<GalleryPreview image={image} eager={eager && index === 0} />
						)}
					</div>
					{image.caption && (
						<figcaption class="gallery__caption">
							<span class="gallery__caption-text">{image.caption}</span>
						</figcaption>
					)}
				</figure>
			))}
		</div>
		{lightbox && (
			<dialog class="gallery__viewer" aria-label={`${label} image viewer`}>
				<div class="gallery__viewer-content">
					<div class="gallery__toolbar">
						<p class="gallery__count" aria-live="polite" aria-atomic="true"></p>
						<button class="gallery__control" type="button" data-gallery-close aria-label="Close image viewer" title="Close (Escape)" autofocus>
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 6 12 12M18 6 6 18" /></svg>
						</button>
					</div>
					<div class="gallery__stage">
						<!-- Hidden slides carry only previews; selected images upgrade after opening. -->
						<img class="gallery__full-image" src={withBase(images[0].previewSrc || images[0].src)} alt={images[0].alt} loading="lazy" decoding="async" />
						<div class="gallery__swipe-track" role="group" aria-roledescription="carousel" aria-label="Images. Swipe sideways or use arrow keys to browse. Swipe down quickly to close.">
							{images.map((image, index) => (
								<div class="gallery__slide" role="group" aria-roledescription="slide" aria-label={`Image ${index + 1} of ${images.length}`}>
									<div class="gallery__media">
										<img src={withBase(image.previewSrc || image.src)} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" draggable="false" />
									</div>
								</div>
							))}
						</div>
						{images.length > 1 && (
							<>
								<button class="gallery__control gallery__previous" type="button" data-gallery-prev aria-label="Previous image" title="Previous image (Left arrow)">
									<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m14 6-6 6 6 6" /></svg>
								</button>
								<button class="gallery__control gallery__next" type="button" data-gallery-next aria-label="Next image" title="Next image (Right arrow)">
									<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m10 6 6 6-6 6" /></svg>
								</button>
							</>
						)}
					</div>
					<div class="gallery__viewer-footer">
						<p class="gallery__viewer-caption"></p>
						{images.length > 1 && (
							<div class="gallery__dots" aria-hidden="true">
								{images.map((_, index) => <span class:list={['gallery__dot', { 'is-active': index === 0 }]} />)}
							</div>
						)}
						{images.length > 1 && (
							<div class="gallery__thumbnails" role="group" aria-label="Choose an image">
								{images.map((image, index) => (
									<button class="gallery__thumbnail" type="button" data-gallery-image={index} aria-label={`View image ${index + 1}: ${image.alt}`} aria-pressed={index === 0}>
										<img src={withBase(image.previewSrc || image.src)} alt="" loading="lazy" decoding="async" />
									</button>
								))}
							</div>
						)}
					</div>
				</div>
			</dialog>
		)}
	</image-gallery>
)}

<script>
	import { setupGallery } from '../utils/gallery';

	class ImageGallery extends HTMLElement {
		private cleanup?: () => void;

		connectedCallback() {
			this.cleanup ??= setupGallery(this);
		}

		disconnectedCallback() {
			this.cleanup?.();
			this.cleanup = undefined;
		}
	}

	if (!customElements.get('image-gallery')) customElements.define('image-gallery', ImageGallery);
</script>
