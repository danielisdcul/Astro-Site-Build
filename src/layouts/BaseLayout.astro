---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SectionTracker from '../components/SectionTracker.astro';
import SectionJumpNav from '../components/SectionJumpNav.astro';
import type { SectionNavigationItem } from '../utils/section-navigation';
import { site } from '../data/site.ts';
import { withBase } from '../utils/paths.ts';
import '../styles/global.css';

type Props = {
	title?: string;
	description?: string;
	sectionNavigation?: SectionNavigationItem[];
	galleryNavigation?: boolean;
};

const { title, description = site.description, sectionNavigation = [], galleryNavigation = false } = Astro.props;
const pageTitle = title
	? `${title} — ${site.name}`
	: `${site.name} — ${site.title}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<Header />
		<main class="page-content" id="main-content">
			{sectionNavigation.length > 0 && (
				<div class="shell section-jump-host">
					<SectionJumpNav items={sectionNavigation} gallery={galleryNavigation} />
				</div>
			)}
			<slot />
		</main>
		<SectionTracker />
		<Footer />
	</body>
</html>
