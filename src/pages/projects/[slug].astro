---
import ProjectCaseStudy from '../../components/ProjectCaseStudy.astro';
import { projects } from '../../data/projects/index.ts';
import type { Project } from '../../data/projects/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSectionNavigation } from '../../utils/section-navigation';

export function getStaticPaths() {
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

type Props = {
	project: Project;
};

const { project } = Astro.props;
const sectionNavigation = createSectionNavigation(project.sections);
---

<BaseLayout title={project.title} description={project.summary} sectionNavigation={sectionNavigation} galleryNavigation>
	<ProjectCaseStudy project={project} sectionNavigation={sectionNavigation} />
</BaseLayout>
