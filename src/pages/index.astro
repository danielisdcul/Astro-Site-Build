---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { home } from '../data/pages/home.ts';
import { projects } from '../data/projects/index.ts';
import { emailLink, site } from '../data/site.ts';
import { withBase } from '../utils/paths.ts';

const homeProjects = projects.filter((project) => project.showOnHome);
const featuredProjects = homeProjects.filter((project) => project.featured);
const gridProjects = homeProjects.filter((project) => !project.featured);
---

<BaseLayout description={home.intro}>
	<div class="home-section-label" hidden>
		<div class="shell">
			<p class="eyebrow"></p>
			<p class="home-section-label__subheading" hidden></p>
		</div>
	</div>
	<section class="shell hero" data-scroll-reveal>
		<div class="hero__copy">
			<div class="hero__lead">
				<h1 class="hero__title" data-typed-text={home.title}>{home.title}</h1>
				<p class="hero__intro">{home.intro}</p>
			</div>
			<div class="hero__footer">
				<a class="text-link hero__link" href={withBase(home.aboutLink.href)}>
					{home.aboutLink.label} <span class="link-arrow" aria-hidden="true">→</span>
				</a>
				<p class="meta-list">
					{home.heroMeta.map((item) => <span>{item}</span>)}
				</p>
			</div>
		</div>
		<img
			class="hero__portrait"
			src={withBase(home.portrait.src)}
			alt={home.portrait.alt}
			width="520"
			height="520"
		/>
	</section>

	<script is:inline>
		const heroTitle = document.querySelector('.hero__title');
		const heroIntro = document.querySelector('.hero__intro');
		const heroLink = document.querySelector('.hero__link');

		if (heroTitle && heroIntro && heroLink && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			const fullText = heroTitle.dataset.typedText || heroTitle.textContent || '';
			heroTitle.setAttribute('aria-label', fullText);
			heroTitle.textContent = '';
			heroTitle.classList.add('is-typing');
			heroIntro.classList.add('is-hidden');
			heroLink.classList.add('is-hidden');

			const characters = Array.from(fullText);
			let index = 0;

			const typeTitle = () => {
				if (index < characters.length) {
					heroTitle.textContent = characters.slice(0, index + 1).join('');
					index += 1;
					setTimeout(typeTitle, 22);
					return;
				}

				heroTitle.classList.remove('is-typing');
				heroTitle.classList.add('is-visible');
				setTimeout(() => {
					heroIntro.classList.remove('is-hidden');
					heroIntro.classList.add('is-visible');
				}, 80);
				setTimeout(() => {
					heroLink.classList.remove('is-hidden');
					heroLink.classList.add('is-visible');
				}, 180);
			};

			typeTitle();
		}
	</script>

	<section class="shell projects" aria-labelledby="selected-work" data-scroll-reveal>
		<header class="section-heading">
			<div>
				<p class="eyebrow">{home.workLabel}</p>
				<h2 id="selected-work">{home.workHeading}</h2>
			</div>
			<p>{home.workIntro}</p>
		</header>
		{featuredProjects.map((project) => <ProjectCard project={project} />)}
		<div class="project-grid">
			{gridProjects.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<section class="shell disciplines" aria-labelledby="disciplines-heading" data-scroll-reveal>
		<p class="eyebrow">{home.disciplinesLabel}</p>
		<div class="disciplines__intro">
			<h2 id="disciplines-heading">{home.disciplinesHeading}</h2>
			<p>{home.disciplinesIntro}</p>
		</div>
		<ol class="disciplines__list list-reset">
			{
				home.services.map((service, index) => (
					<li>
						<span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
						<h3>{service.title}</h3>
						<p>{service.description}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="shell closing-callout" data-scroll-reveal>
		<div>
			<p class="eyebrow">{home.calloutLabel}</p>
			<h2>{home.calloutHeading}</h2>
		</div>
		<div class="closing-callout__details">
			<a class="text-link" href={emailLink.href}>
				{site.email} <span class="link-arrow" aria-hidden="true">→</span>
			</a>
			<p>{home.availability}</p>
		</div>
	</section>

	<script is:inline>
		(() => {
			const bar = document.querySelector('.home-section-label');
			const header = document.querySelector('.site-header');
			const label = bar?.querySelector('.eyebrow');
			const subheading = bar?.querySelector('.home-section-label__subheading');
			if (!bar || !header || !label || !subheading) return;
			header.append(bar);
			const markers = Array.from(document.querySelectorAll('.projects > .section-heading .eyebrow, .disciplines > .eyebrow, .closing-callout > div > .eyebrow'));
			const mobile = window.matchMedia('(max-width: 800px)');
			let pending = false;
			let heightAnimation;
			let previousWidth = window.innerWidth;
			const update = () => {
				pending = false;
				const previousHeight = bar.hidden ? 0 : bar.getBoundingClientRect().height;
				const boundary = header.getBoundingClientRect().bottom + 40;
				let current = '';
				let currentSection = null;
				let currentSubheading = '';
				if (mobile.matches) {
					for (const marker of markers) {
						if (marker.getBoundingClientRect().top <= boundary) {
							current = marker.textContent || '';
							currentSection = marker.closest('section');
						}
					}
					if (currentSection) {
						for (const heading of currentSection.querySelectorAll('.project-card h2, .disciplines__list h3')) {
							if (heading.getBoundingClientRect().top <= boundary) currentSubheading = heading.textContent || '';
						}
					}
					if (document.querySelector('.closing-callout').getBoundingClientRect().bottom <= boundary) current = '';
				}
				const sizeChanged = label.textContent !== current || subheading.textContent !== currentSubheading || previousWidth !== window.innerWidth;
				previousWidth = window.innerWidth;
				if (label.textContent !== current) {
					const wasVisible = !bar.hidden;
					label.textContent = current;
					if (current && wasVisible && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						label.animate([
							{ opacity: 0, transform: 'translateY(12px)' },
							{ opacity: 1, transform: 'translateY(0)' },
						], { duration: 200, easing: 'ease-out' });
					}
				}
				if (subheading.textContent !== currentSubheading) {
					const firstSubsection = !subheading.textContent;
					subheading.textContent = currentSubheading;
					if (currentSubheading && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						subheading.animate([
							{ opacity: 0, transform: firstSubsection ? 'translateY(-100%)' : 'translateY(8px)' },
							{ opacity: 1, transform: 'translateY(0)' },
						], { duration: 200, easing: 'ease-out' });
					}
				}
				subheading.hidden = !currentSubheading;
				bar.hidden = !current;
				if (current && sizeChanged) {
					heightAnimation?.cancel();
					const nextHeight = bar.getBoundingClientRect().height;
					if (previousHeight && Math.abs(nextHeight - previousHeight) > 0.5 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
						heightAnimation = bar.animate([
							{ height: `${previousHeight}px` },
							{ height: `${nextHeight}px` },
						], { duration: 200, easing: 'ease-out' });
					}
				}
			};
			const schedule = () => {
				if (!pending) {
					pending = true;
					requestAnimationFrame(update);
				}
			};
			window.addEventListener('scroll', schedule, { passive: true });
			window.addEventListener('resize', schedule);
			window.addEventListener('pageshow', schedule);
			new ResizeObserver(schedule).observe(document.body);
			update();
		})();

		if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			// Reveal tall sections in smaller pieces so each part responds to scrolling.
			for (const section of document.querySelectorAll('.projects[data-scroll-reveal], .disciplines[data-scroll-reveal]')) {
				section.removeAttribute('data-scroll-reveal');
				for (const child of section.children) {
					if (child.matches('.project-grid, .disciplines__list')) {
						for (const item of child.children) item.setAttribute('data-scroll-reveal', '');
					} else {
						child.setAttribute('data-scroll-reveal', '');
					}
				}
			}

			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					entry.target.classList.toggle('is-reveal-pending', !entry.isIntersecting);
				}
			}, { threshold: 0, rootMargin: `0px 0px -${Math.round(window.innerHeight * 0.18)}px 0px` });

			for (const section of document.querySelectorAll('[data-scroll-reveal]')) {
				section.classList.add('is-reveal-pending');
				observer.observe(section);
			}
		}
	</script>
</BaseLayout>
